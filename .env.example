# ============================================================
#   Élevage Benhaimoud — Environment Variables
#   Copy this file to .env and fill in your real values
#   NEVER commit .env to GitHub!
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Get this from: https://cloud.mongodb.com (free Atlas cluster)
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/elevage-benhaimoud
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/elevage-benhaimoud

# --- JWT (JSON Web Token) ---
# This is your secret key for signing tokens — make it long and random
# Generate one at: https://www.allkeysgenerator.com/Random/Security-Encryption-Key-Generator.aspx
JWT_SECRET=your_super_secret_jwt_key_make_it_very_long_and_random
JWT_EXPIRES_IN=7d

# --- Cloudinary (image & video storage) ---
# Get these from: https://cloudinary.com (free tier — 25GB storage)
# Go to: Dashboard > Account Details
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Admin Account (created on first run) ---
ADMIN_EMAIL=admin@elevage-benhaimoud.ma
ADMIN_PASSWORD=ChangeThisPassword123!
